[Rule]

# Whitelist (explicit allow, evaluated before the block list):
DOMAIN-SUFFIX,cnnic.cn,DIRECT
DOMAIN-SUFFIX,cnnic.com.cn,DIRECT
DOMAIN-SUFFIX,cnnic.net,DIRECT
DOMAIN-SUFFIX,cnnic.net.cn,DIRECT
DOMAIN-SUFFIX,video.qq.com,DIRECT
DOMAIN-SUFFIX,v.qq.com,DIRECT

# Block list (remote rule set, auto-updates when rebuilt):
RULE-SET,https://raw.githubusercontent.com/Takuuaka/shadowrocket/main/JARVIS-AdBlock.list,REJECT
